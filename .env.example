# ==============================================================================
# NEIRO YOMI Environment Configuration (.env.example)
# Hear Every Detail. The Art of Listening.
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=False
APP_NAME="NEIRO YOMI"
APP_VERSION="0.1.0"
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & Authentication (Generate a secure random key for JWT)
SECRET_KEY=neiro-yomi-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Whitelist (Comma-separated origins or * for all)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tu-frontend.vercel.app

# ==============================================================================
# SUPABASE CONFIGURATION (Recommended Production Setup)
# ==============================================================================
# 1. PostgreSQL Connection String from Supabase:
#    Go to: Supabase Dashboard > Project Settings > Database > Connection String (URI)
#    - Direct Session Mode (Port 5432):
#      DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#    - Connection Pooler (Port 6543):
#      DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[TU-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# 2. Supabase API & Object Storage (Backend Service Role):
#    Go to: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... # service_role secret key (full backend access & storage upload)
SUPABASE_BUCKET_AUDIO=neiro-audio
SUPABASE_BUCKET_ARTWORK=neiro-artwork

# Storage Provider: "supabase" (cloud) or "local" (offline disk)
STORAGE_PROVIDER=supabase

# ==============================================================================
# LOCAL / OFFLINE FALLBACK (If Supabase is not configured)
# ==============================================================================
# DATABASE_URL=sqlite:///./data/neiro_yomi.db
LOCAL_STORAGE_PATH=./storage

# Audiophile Transcoding & Analysis Limits
MAX_UPLOAD_SIZE_MB=500
SUPPORTED_FORMATS=flac,alac,wav,aiff,mp3,aac,opus
ENABLE_HIRES_ANALYSIS=True
PRESERVE_ORIGINAL_STREAM=True
DEFAULT_STREAM_BUFFER_SIZE=65536
